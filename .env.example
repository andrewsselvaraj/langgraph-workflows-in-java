# Copy to .env (git-ignored). Spring Boot loads it on startup.

# LLM: cerebras (default) | ollama | openai. Any OpenAI-compatible endpoint works via LLM_BASE_URL.
LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=
LLM_MODEL=gpt-oss-120b
# For Ollama: LLM_PROVIDER=ollama and LLM_MODEL=gpt-oss:20b (no key needed)

# Web search (projects 02, 03, 08, 18)
TAVILY_API_KEY=

# WordPress publishing (project 22), e.g. https://your-domain.com/xmlrpc.php
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_PASSWORD=

# Optional GitHub deploy (project 23)
GITHUB_TOKEN=
