# Copy to .env (git-ignored). Spring Boot loads it on startup.

# LLM via Spring AI's OpenAI client (spring.ai.openai.*). Defaults to Cerebras, as in the Python repo.
CEREBRAS_API_KEY=
LLM_MODEL=gpt-oss-120b
LLM_BASE_URL=https://api.cerebras.ai/v1
# For Ollama: LLM_BASE_URL=http://localhost:11434/v1 and LLM_MODEL=gpt-oss:20b (no key needed)

# Web search (projects 02, 03, 08, 18)
TAVILY_API_KEY=

# WordPress publishing (project 22), e.g. https://your-domain.com/xmlrpc.php
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_PASSWORD=

# Optional GitHub deploy (project 23)
GITHUB_TOKEN=
